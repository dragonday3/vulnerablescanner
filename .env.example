# Backend
DATABASE_URL=postgresql+psycopg://vulnsight:vulnsight@postgres:5432/vulnsight
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (used by the postgres service itself)
POSTGRES_USER=vulnsight
POSTGRES_PASSWORD=vulnsight
POSTGRES_DB=vulnsight

# Backend tests (backend/tests/conftest.py) run against a second database,
# `vulnsight_test`, on this same Postgres server/container - it is created
# automatically by the test suite on first run if it doesn't already exist,
# so no manual setup is required. Override via TEST_DATABASE_URL if needed;
# defaults to the same host/credentials as DATABASE_URL above with the
# database name swapped to vulnsight_test.
# TEST_DATABASE_URL=postgresql+psycopg://vulnsight:vulnsight@localhost:5432/vulnsight_test

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Windows hot-reload fallback (uncomment if file-change events aren't detected)
# WATCHFILES_FORCE_POLLING=true
# WATCHPACK_POLLING=true
